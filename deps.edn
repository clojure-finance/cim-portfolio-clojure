{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/data.json {:mvn/version "2.5.1"}
        org.slf4j/slf4j-api {:mvn/version "2.0.9"}
        org.slf4j/slf4j-simple {:mvn/version "2.0.9"}
        generateme/fastmath {:mvn/version "3.0.0-alpha3"}
        ;; Web framework
        ring/ring-core {:mvn/version "1.15.3"}
        ring/ring-jetty-adapter {:mvn/version "1.15.3"}
        hiccup/hiccup {:mvn/version "2.0.0"}
        ;; Portfolio data sources
        com.github.clojure-finance/clj-yfinance {:mvn/version "0.1.8"}
        com.github.clojure-finance/ecbjure {:mvn/version "0.1.5"}
        ;; News analysis
        clj-http/clj-http {:mvn/version "3.12.3"}
        cheshire/cheshire {:mvn/version "5.11.0"}
        org.jsoup/jsoup {:mvn/version "1.17.2"}}

 :aliases
 {;; Start the web app: clojure -M:run [port]
  :run {:main-opts ["-m" "cim-portfolio.core"]}

  ;; Run the tests: clojure -M:test
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}

  ;; REPL for editors and clojure-mcp: clojure -M:nrepl
  :nrepl {:extra-paths ["test"]
          :extra-deps {nrepl/nrepl {:mvn/version "1.7.0"}}
          :main-opts ["-m" "nrepl.cmdline" "--port" "0"]}

  ;; Build the standalone jar: clojure -T:build uber
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.7"}}
          :ns-default build}}}

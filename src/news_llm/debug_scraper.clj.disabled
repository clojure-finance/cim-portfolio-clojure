(ns debug-scraper
  (:require [clj-http.client :as http]
            [clojure.string :as str]))

(defn test-jina [url]
  (println "--------------------------------------------------")
  (println "Testing Jina Reader for URL:" url)
  (try
    (let [jina-url (str "https://r.jina.ai/" url)
          _ (println "Requesting:" jina-url)
          resp (http/get jina-url
                         {:headers {"User-Agent" "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"}
                          :timeout 30000
                          :throw-exceptions false})]
      (println "Response Status:" (:status resp))
      (println "Body Length:" (count (:body resp)))
      (if (= 200 (:status resp))
        (println "Body Preview:" (subs (:body resp) 0 (min 200 (count (:body resp)))))
        (println "Error Body:" (:body resp))))
    (catch Exception e
      (println "Exception occurred:" (.getMessage e))
      (.printStackTrace e))))

;; Test with a known accessible article and a potentially difficult one
(test-jina "https://www.bbc.com/news")
(test-jina "https://www.cnn.com")

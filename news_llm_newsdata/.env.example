# ============================================
# NEWS LLM ANALYSIS - ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit your actual .env file to version control!
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your API keys
#   source .env  (Linux/macOS)
# ============================================

# --------------------------------------------
# REQUIRED API KEYS
# --------------------------------------------

# Newsdata.io API Key
# Register at: https://newsdata.io
# Free tier: 200 requests/day
NEWSDATA_API_KEY=your_newsdata_api_key_here

# OpenRouter API Key
# Register at: https://openrouter.ai
# Free tier: Access to free models
# Note: Some models require credits (paid)
OPENROUTER_API_KEY=your_openrouter_api_key_here


# --------------------------------------------
# OPTIONAL: MODEL CONFIGURATION
# --------------------------------------------

# Primary LLM Model (default: free model)
# Browse models: https://openrouter.ai/models
# Examples:
#   meta-llama/llama-3.2-3b-instruct:free  (default, free)
#   qwen/qwen-2.5-72b-instruct:free        (free, high quality)
#   deepseek/deepseek-r1:free              (free, slower)
#   openai/gpt-4o-mini                     (paid)
#   anthropic/claude-3-haiku               (paid)
# LLM_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Fallback Model (used when primary hits rate limit 429)
# Recommended: use a paid model as fallback for reliability
# LLM_FALLBACK_MODEL=openai/gpt-4o-mini


# --------------------------------------------
# OPTIONAL: DOC2VEC EMBEDDING SERVICE
# --------------------------------------------

# Doc2Vec embedding service URL
# Default: http://localhost:8000
# If service unavailable, system auto-falls back to TF-IDF
#
# To start the service:
#   cd embeddings
#   pip install -r requirements.txt
#   uvicorn service:app --host 0.0.0.0 --port 8000
# EMBEDDING_URL=http://localhost:8000


# --------------------------------------------
# OPTIONAL: REQUEST SETTINGS
# --------------------------------------------

# Request delay in milliseconds (default: 1000)
# Increase if you hit frequent rate limits
# REQUEST_DELAY=1000

# Maximum retry count (default: 2)
# MAX_RETRIES=2

# Similarity threshold for clustering (default: 0.7)
# Range: 0.0 - 1.0
# SIMILARITY_THRESHOLD=0.7


# --------------------------------------------
# OPTIONAL: OUTPUT SETTINGS
# --------------------------------------------

# Output directory (default: "dynamic report")
# OUTPUT_DIR=dynamic report

# Output format (default: txt)
# Options: txt, json, csv, md
# OUTPUT_FORMAT=txt


# ============================================
# MODEL RECOMMENDATIONS
# ============================================
#
# For FREE Usage (recommended for testing):
#   Primary:  meta-llama/llama-3.2-3b-instruct:free
#   Fallback: qwen/qwen-2.5-72b-instruct:free
#
# For PRODUCTION (cost-effective paid fallback):
#   Primary:  meta-llama/llama-3.2-3b-instruct:free
#   Fallback: openai/gpt-4o-mini
#
# For BEST QUALITY (all paid):
#   Primary:  openai/gpt-4o
#   Fallback: anthropic/claude-3-sonnet
#
# ============================================
